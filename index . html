<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CR7 Caceria - Balones de Oro</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0a0a0a;color:#fff;font-family:system-ui;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center}
#ui{position:absolute;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;font-weight:bold;z-index:10}
#ui div{background:rgba(0,0,0,.7);padding:8px 12px;border-radius:12px;border:1px solid gold}
canvas{background:linear-gradient(#1a3a1a, #0a2a0a);border:3px solid gold;border-radius:16px;touch-action:none;max-width:95vw;max-height:70vh}
#controls{margin-top:10px;display:flex;gap:20px}
.btn{width:80px;height:80px;background:rgba(255,255,255,.15);border:2px solid gold;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:30px;user-select:none}
.btn:active{background:gold}
#startScreen{position:absolute;inset:0;background:rgba(0,0,0,.9);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:20;text-align:center;padding:20px}
h1{color:gold;font-size:32px;text-shadow:0 0 15px gold}
button#play{margin-top:20px;padding:14px 30px;background:gold;color:#000;font-weight:900;border:none;border-radius:30px;font-size:18px}
</style>
</head>
<body>
<div id="ui"><div>⚽ <span id="score">0</span></div><div>🏆 <span id="balls">0/10</span></div><div>❤️ <span id="lives">3</span></div></div>
<div id="startScreen">
<h1>CR7 CACERÍA</h1>
<p>¡Ayuda a CR7 a recolectar 10 Balones de Oro!</p>
<p style="margin-top:8px;font-size:13px;opacity:.7">Esquiva los defensas 🥷</p>
<button id="play">JUGAR COMO CR7 ⚽</button>
</div>
<canvas id="game" width="360" height="640"></canvas>
<div id="controls"><div class="btn" id="left">👈</div><div class="btn" id="right">👉</div></div>
<script>
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
let score=0,ballCount=0,lives=3,gameRunning=false,keys={};
let player={x:160,y:520,w:40,h:50,speed:7};
let objs=[],lastSpawn=0;
const startScreen=document.getElementById('startScreen');
function updateUI(){document.getElementById('score').textContent=score;document.getElementById('balls').textContent=ballCount+'/10';document.getElementById('lives').textContent=lives;}
function spawn(){const isBall=Math.random()<0.35;objs.push({x:Math.random()*(canvas.width-30),y:-40,w:30,h:30,type:isBall?'ball':'enemy',speed:2+Math.random()*3+ballCount*0.3});}
function loop(t){if(!gameRunning)return;if(t-lastSpawn>600){spawn();lastSpawn=t;}ctx.clearRect(0,0,canvas.width,canvas.height);if(keys['left'])player.x-=player.speed;if(keys['right'])player.x+=player.speed;player.x=Math.max(0,Math.min(canvas.width-player.w,player.x));ctx.font='40px serif';ctx.fillText('🐐',player.x,player.y+35);ctx.font='12px sans-serif';ctx.fillStyle='gold';ctx.fillText('CR7',player.x+8,player.y+50);for(let i=objs.length-1;i>=0;i--){let o=objs[i];o.y+=o.speed;if(o.type==='ball'){ctx.font='28px serif';ctx.fillText('🏆',o.x,o.y);}else{ctx.font='28px serif';ctx.fillText('🥷',o.x,o.y);}if(o.y+o.h>player.y&&o.y<player.y+player.h&&o.x+o.w>player.x&&o.x<player.x+player.w){if(o.type==='ball'){score+=100;ballCount++;if(ballCount>=10){gameRunning=false;startScreen.style.display='flex';startScreen.innerHTML=`<h1>¡SIUUU! 🏆</h1><p>Puntaje: ${score}</p><button id=play onclick=location.reload()>DE NUEVO</button>`;return;}}else{lives--;if(lives<=0){gameRunning=false;startScreen.style.display='flex';startScreen.innerHTML=`<h1>GAME OVER</h1><p>Puntaje: ${score}</p><button id=play onclick=location.reload()>REINTENTAR</button>`;return;}}objs.splice(i,1);updateUI();continue;}if(o.y>700)objs.splice(i,1);}requestAnimationFrame(loop);}
document.getElementById('play').addEventListener('click',()=>{score=0;ballCount=0;lives=3;objs=[];player.x=160;updateUI();startScreen.style.display='none';gameRunning=true;requestAnimationFrame(loop);});
window.addEventListener('keydown',e=>keys[e.key]=true);window.addEventListener('keyup',e=>keys[e.key]=false);
document.getElementById('left').addEventListener('touchstart',()=>keys['left']=true);document.getElementById('left').addEventListener('touchend',()=>keys['left']=false);
document.getElementById('right').addEventListener('touchstart',()=>keys['right']=true);document.getElementById('right').addEventListener('touchend',()=>keys['right']=false);
let touchX=0;canvas.addEventListener('touchstart',e=>{touchX=e.touches[0].clientX;});canvas.addEventListener('touchmove',e=>{let dx=e.touches[0].clientX-touchX;player.x+=dx*0.3;touchX=e.touches[0].clientX;e.preventDefault();},{passive:false});
</script>
</body>
</html>